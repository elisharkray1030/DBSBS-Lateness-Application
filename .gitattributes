# Normalize text files to LF in the repository so Windows checkouts do not
# register the whole tree as modified. Windows-only scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or normalize.
*.db binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
