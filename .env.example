# Docker Compose reads this file before `docker compose up`.
# Copy it to `.env` and set SECRET_KEY to a per-host secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides. Uncomment to change the defaults.
# BIND_ADDR=0.0.0.0    # host bind address; 127.0.0.1 for loopback only
# APP_PORT=8000        # host port the app listens on
# BACKUP_KEEP=7        # timestamped backups kept in shared/backups
# LOG_LEVEL=INFO       # application log level
